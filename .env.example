# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional centralized Gemini model override.
# Defaults to gemini-3.6-flash. Keep blank unless you intentionally want another supported model.
GEMINI_MODEL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token for Telegram Bot to send scripts and notifications.
# Obtain from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Default channel username (e.g., @my_channel) or chat ID.
TELEGRAM_CHAT_ID=

# SUPADATA_API_KEY: Optional API key for Supadata.ai to extract transcripts when YouTube blocks direct downloads.
SUPADATA_API_KEY=

# CHOCODATA_API_KEY: Optional API key for ChocoData YouTube Transcript Scraper API (tier B2 fallback).
CHOCODATA_API_KEY=

# YOUTUBE_API_KEY: Optional official YouTube Data API v3 key for Radar discovery search.
# Without it, Radar falls back to public YouTube web search parsing.
YOUTUBE_API_KEY=


# APP_STORAGE: Persistence backend for application state.
# local-json = existing data/store.json only
# dual = write both local JSON and Firestore (recommended during migration)
# firestore = Firestore is the primary persistent source of truth
APP_STORAGE=firestore

# FIRESTORE_DATABASE_ID: Firestore database to use.
# Use (default), or omit this variable entirely to use the default Firestore database.
FIRESTORE_DATABASE_ID=(default)

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of a Google Cloud / Firebase service account key
# with Cloud Datastore User permissions for server-side Firestore persistence.
FIREBASE_SERVICE_ACCOUNT_KEY=

