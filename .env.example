# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional centralized Gemini model override.
# Defaults to gemini-3.6-flash. Keep blank unless you intentionally want another supported model.
GEMINI_MODEL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token for Telegram Bot to send scripts and notifications.
# Obtain from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Default channel username (e.g., @my_channel) or chat ID.
TELEGRAM_CHAT_ID=

# SUPADATA_API_KEY: Optional API key for Supadata.ai to extract transcripts when YouTube blocks direct downloads.
SUPADATA_API_KEY=

# CHOCODATA_API_KEY: Optional API key for ChocoData YouTube Transcript Scraper API (tier B2 fallback).
CHOCODATA_API_KEY=

# YOUTUBE_API_KEY: Optional official YouTube Data API v3 key for Radar discovery search.
# Without it, Radar falls back to public YouTube web search parsing.
YOUTUBE_API_KEY=


# APP_STORAGE: Persistence backend for application state.
# local-json = existing data/store.json only
# dual = write both local JSON and Firestore (recommended during migration)
# firestore = Firestore is the primary persistent source of truth
APP_STORAGE=firestore

# FIRESTORE_DATABASE_ID: Firestore database to use.
# Use (default), or omit this variable entirely to use the default Firestore database.
FIRESTORE_DATABASE_ID=(default)

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of a Google Cloud / Firebase service account key
# with Cloud Datastore User permissions for server-side Firestore persistence.
FIREBASE_SERVICE_ACCOUNT_KEY=



# OPENAI_API_KEY: Optional server-side OpenAI key. Never expose this as a VITE_ variable.
# Used for paid LLM fallback and, when explicitly enabled, Radar Web Search.
OPENAI_API_KEY=

# OpenAI text fallback model. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Web Search model. Defaults to OPENAI_MODEL, then gpt-4.1-mini.
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini

# Web Search is opt-in even when OPENAI_API_KEY exists.
OPENAI_WEB_SEARCH_ENABLED=false

# Paid LLM routing is opt-in. Free/included providers are always tried first.
ALLOW_PAID_AI_FALLBACK=false


# Web Search router. Providers are called sequentially and stop after enough unique results.
# Default order is free/low-cost first, paid OpenAI last.
WEB_SEARCH_PROVIDER_ORDER=google,tavily,brave,openai

# Tavily: free monthly credits are suitable for normal Discovery traffic.
TAVILY_API_KEY=

# Brave Search API: optional free-credit fallback.
BRAVE_SEARCH_API_KEY=

# Google Search grounding uses the existing GEMINI_API_KEY.
# Search-request allowance may be included, but Gemini model tokens can still be billable.
GOOGLE_WEB_SEARCH_ENABLED=true
GEMINI_WEB_SEARCH_MODEL=

# OpenAI Web Search stays the paid last-resort fallback.
# It also requires OPENAI_API_KEY above.

# Server-side provider metering for Admin → AI Usage.
WEB_SEARCH_USAGE_LOGGING=true
