        },
        {
          "text": "the time, no one could say,",
          "offset": 1228,
          "duration": 7,
          "formattedTime": "20:28"
        },
        {
          "text": "but one thing is always abundantly",
          "offset": 1232,
          "duration": 6,
          "formattedTime": "20:31"
        },
        {
          "text": "clear.",
          "offset": 1235,
          "duration": 8,
          "formattedTime": "20:34"
        },
        {
