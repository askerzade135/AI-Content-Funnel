        },
        {
          "text": "home.",
          "offset": 1007,
          "duration": 3,
          "formattedTime": "16:46"
        },
        {
          "text": "At around the same time, one of the",
          "offset": 1016,
          "duration": 5,
          "formattedTime": "16:56"
        },
