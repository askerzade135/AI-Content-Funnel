        },
        {
          "text": "drinking water themselves,",
          "offset": 744,
          "duration": 5,
          "formattedTime": "12:24"
        },
        {
          "text": "Turkeykey's government was then far from",
          "offset": 747,
          "duration": 5,
          "formattedTime": "12:26"
        },
        {
          "text": "a corrupt dictatorship.",
          "offset": 749,
          "duration": 7,
          "formattedTime": "12:29"
        },
        {
          "text": "As in many places in the Middle East,",
          "offset": 752,
          "duration": 5,
          "formattedTime": "12:31"
        },
        {
          "text": "as a result of the reforms of Ataturk",
          "offset": 757,
          "duration": 5,
          "formattedTime": "12:36"
        },
        {
          "text": "some decades earlier, a genuine",
          "offset": 759,
          "duration": 4,
          "formattedTime": "12:39"
        },
        {
          "text": "homegrown desire to pursue",
          "offset": 762,
          "duration": 4,
