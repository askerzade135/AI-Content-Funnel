        },
        {
          "text": "Neolithic site in 1983,",
          "offset": 924,
          "duration": 6,
          "formattedTime": "15:23"
        },
        {
          "text": "it wasn't long before an unusually",
          "offset": 928,
          "duration": 5,
          "formattedTime": "15:27"
        },
        {
          "text": "complex series of massive freestanding",
          "offset": 930,
          "duration": 8,
          "formattedTime": "15:29"
        },
        {
          "text": "stone buildings began to be unearthed.",
          "offset": 933,
          "duration": 5,
          "formattedTime": "15:32"
        },
        {
          "text": "Initially known as the Roman burial,",
          "offset": 938,
          "duration": 7,
          "formattedTime": "15:37"
        },
        {
          "text": "from 1987 onwards, the digs brought",
          "offset": 941,
          "duration": 7,
          "formattedTime": "15:41"
        },
        {
          "text": "forth things never before seen by modern",
          "offset": 944,
          "duration": 7,
          "formattedTime": "15:44"
        },
        {
          "text": "eyes.",
          "offset": 948,
          "duration": 3,
          "formattedTime": "15:48"
        },
        {
          "text": "A terratzo floored building or enclosure",
          "offset": 952,
          "duration": 7,
          "formattedTime": "15:51"
        },
        {
          "text": "began to be unearthed,",
          "offset": 955,
          "duration": 4,
          "formattedTime": "15:55"
        },
        {
          "text": "elaborately constructed with layers of",
          "offset": 959,
