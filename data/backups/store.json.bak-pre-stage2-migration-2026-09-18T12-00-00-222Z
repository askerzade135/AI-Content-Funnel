        },
        {
          "text": "catalyst for the second crusade.",
          "offset": 1101,
          "duration": 4,
          "formattedTime": "18:21"
        },
        {
          "text": "[Music]",
          "offset": 1107,
          "duration": 4,
          "formattedTime": "18:27"
        },
        {
          "text": "The name itself was brought by Alexander",
          "offset": 1113,
