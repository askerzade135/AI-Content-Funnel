          "formattedTime": "19:20"
        },
        {
          "text": "plateau beyond rising to the north",
          "offset": 1163,
          "duration": 6,
          "formattedTime": "19:22"
        },
        {
          "text": "at this gateway to the rolling plains of",
          "offset": 1166,
          "duration": 5,
          "formattedTime": "19:26"
        },
        {
