          "formattedTime": "17:57"
        },
        {
          "text": "name.",
          "offset": 1080,
          "duration": 5,
          "formattedTime": "18:00"
        },
        {
          "text": "Adessa.",
          "offset": 1083,
          "duration": 3,
          "formattedTime": "18:02"
        },
        {
          "text": "From this medieval powerhouse, foreign",
          "offset": 1087,
          "duration": 6,
          "formattedTime": "18:07"
        },
        {
          "text": "crusader lords had carved out a kingdom",
          "offset": 1090,
          "duration": 8,
          "formattedTime": "18:10"
        },
        {
          "text": "in the similarly chaotic 12th century.",
          "offset": 1093,
          "duration": 5,
          "formattedTime": "18:13"
        },
        {
          "text": "The city's fall had been the main",
          "offset": 1099,
          "duration": 6,
