        },
        {
          "text": "paradox",
          "offset": 9248,
          "duration": 3,
          "formattedTime": "154:08"
        },
        {
          "text": "of why humanity only began the road to",
          "offset": 9251,
          "duration": 6,
          "formattedTime": "154:11"
        },
        {
          "text": "true societal complexity by around",
          "offset": 9255,
          "duration": 5,
          "formattedTime": "154:14"
        },
