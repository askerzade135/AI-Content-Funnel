          "text": "of agriculture,",
          "offset": 9129,
          "duration": 5,
          "formattedTime": "152:08"
        },
        {
          "text": "Jacqu Kavon suggested not material",
          "offset": 9131,
          "duration": 6,
          "formattedTime": "152:10"
        },
        {
          "text": "reasons for the shift from hunter",
          "offset": 9134,
          "duration": 5,
          "formattedTime": "152:14"
        },
        {
          "text": "gathering to agriculture,",
          "offset": 9136,
          "duration": 6,
          "formattedTime": "152:16"
        },
        {
          "text": "but a transformation that began in the",
          "offset": 9139,
          "duration": 6,
          "formattedTime": "152:18"
        },
        {
          "text": "mind.",
          "offset": 9142,
          "duration": 11,
          "formattedTime": "152:22"
        },
        {
          "text": "[Music]",
          "offset": 9144,
          "duration": 9,
          "formattedTime": "152:24"
        },
        {
          "text": "a profound cultural transformation",
          "offset": 9155,
          "duration": 6,
          "formattedTime": "152:35"
        },
        {
          "text": "within the human psyche from around the",
          "offset": 9158,
          "duration": 8,
          "formattedTime": "152:37"
        },
        {
          "text": "13th to the 10th millennia BC,",
          "offset": 9161,
          "duration": 5,
          "formattedTime": "152:41"
        },
