      "url": "https://www.youtube.com/watch?v=KMKMivAQuw0",
      "description": "",
      "thumbnail": "https://i.ytimg.com/vi/KMKMivAQuw0/hq720.jpg?sqp=-oaymwEcCNAFEJQDSFXyq4qpAw4IARUAAIhCGAFwAcABBg==&rs=AOn4CLCQRlsgRVCZhqJYRJOjlYxtezTC0w",
      "publishedAt": "2026-08-30T06:54:15.965Z",
      "status": "transcribed",
