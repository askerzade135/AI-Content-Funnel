          "formattedTime": "111:05"
        },
        {
          "text": "entirely unexavated,",
          "offset": 6669,
          "duration": 6,
          "formattedTime": "111:09"
        },
        {
          "text": "its secrets hidden.",
          "offset": 6672,
          "duration": 9,
          "formattedTime": "111:12"
        },
        {
          "text": "But more on that in a future video.",
          "offset": 6676,
          "duration": 5,
          "formattedTime": "111:15"
        },
        {
          "text": "Within just a few years, by 577,",
          "offset": 6686,
          "duration": 7,
          "formattedTime": "111:25"
