        },
        {
          "text": "country.",
          "offset": 731,
          "duration": 3,
          "formattedTime": "12:11"
        },
        {
          "text": "[Music]",
          "offset": 736,
          "duration": 6,
          "formattedTime": "12:16"
        },
        {
          "text": "Though widely condemned internationally,",
          "offset": 739,
          "duration": 6,
          "formattedTime": "12:18"
        },
        {
          "text": "largely by nations with plenty of",
          "offset": 742,
